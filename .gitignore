# Environment & secrets (CRITICAL: never commit API keys)
.env
.env*.local

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/

# Node & frontend build
node_modules/
frontend/node_modules/
frontend/dist/
dist/

# Large model weights & checkpoints (GitHub blocks files > 100MB)
*.pth
*.pt
models/*.pth
models/*.pt

# OS & logs
.DS_Store
Thumbs.db
*.log
